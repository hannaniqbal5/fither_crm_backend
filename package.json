{
  "name": "fithercrm-backend",
  "version": "1.0.0",
  "description": "FitHer CRM - Node.js + Express + Baileys + MySQL + Gemini AI + Marketing Campaigns + App Integration",
  "private": true,
  "main": "src/App.js",
  "scripts": {
    "start": "node src/App.js",
    "dev": "nodemon src/App.js",
    "migrate": "node script/runMigration.js migrations/001_phase1_foundation.sql",
    "migrate:p2": "node script/runMigration.js migrations/002_phase2_automation.sql",
    "migrate:p3": "node script/runMigration.js migrations/003_phase3_ai.sql",
    "migrate:p4": "node script/runMigration.js migrations/004_phase4_multichannel.sql",
    "migrate:p5": "node script/runMigration.js migrations/005_phase5_campaigns.sql",
    "migrate:p6": "node script/runMigration.js migrations/006_phase6_app_integration.sql",
    "migrate:all": "node script/runMigration.js --all",
    "migrate:status": "node script/runMigration.js --status",
    "seed:rep": "node script/createSalesrep.js",
    "seed:wa": "node script/createWhatsAppAccount.js",
    "ai:ingest": "node src/ai/ingest.script.js"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "ffmpeg": "^0.0.4",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^13.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.1",
    "multer": "^2.0.2",
    "mysql2": "^3.16.0",
    "node-cron": "^3.0.3",
    "pino": "^10.2.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
