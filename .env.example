# ─── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────
# Frontend URL — change to your production domain in prod
CORS_ORIGIN=http://localhost:3000

# ─── Auth JWT ─────────────────────────────────────────────────
# Access token (15m expiry) — min 32 random chars
JWT_SECRET=replace_with_strong_random_secret_min_32_chars

# Refresh token (7d expiry) — must be DIFFERENT from JWT_SECRET
REFRESH_SECRET=replace_with_different_strong_random_secret

# ─── Database ─────────────────────────────────────────────────
# Option A (recommended): set DB_NAME and the other DB_* vars below — when
# DB_NAME is non-empty these are used and config.json is ignored.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# Option B: leave DB_NAME empty → src/config/config.json is used, profile
# chosen by DB_PROFILE (default "development"). NOT keyed on NODE_ENV, so
# setting NODE_ENV=production never switches databases by itself.
DB_PROFILE=
# Legacy note — config.json:
# Defaults to: localhost:8889, db=crm, user=root, pass=root

# ─── WhatsApp ─────────────────────────────────────────────────
# Business WhatsApp number in international format (no + or spaces)
WA_NUMBER=923001234567

# ─── Firebase (push notifications) ───────────────────────────
# Service account JSON is at src/config/crm-fit-her-firebase-adminsdk-*.json
# Never commit this file to git

# ─── Phase 3 (Flutter App Bridge — add when needed) ──────────
# WEBHOOK_SECRET=replace_with_hmac_secret_shared_with_flutter_backend
# MAGIC_LINK_SECRET=replace_with_jwt_secret_for_magic_links
# BASE_URL=https://crm.fitherapp.com

# ─── Phase 3 — AI Sales Agent (Fiza) ─────────────────────────
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
# NEVER commit this key. Treat as a credential.
GEMINI_API_KEY=

# Gemini models — leave defaults unless you know better options
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# AI behavior toggles
AI_AGENT_ENABLED=false
AI_COPILOT_MODE=true
AI_CONFIDENCE_THRESHOLD=0.65
AI_MAX_RETRIEVAL_CHUNKS=5

# Path to the consolidated knowledge base folder (relative to this backend root)
AI_KB_PATH=../new.md

# ─── Phase 4 — Meta (Instagram + Facebook Messenger) ─────────
# Get these from your Meta App: https://developers.facebook.com
# See META_SETUP_GUIDE_FOR_SHAISTA.md at the repo root for setup steps.

# Public app identifier
META_APP_ID=

# Treat as a credential — never commit
META_APP_SECRET=

# Random string YOU make up (30+ chars). Must match the value you typed in
# the Meta App's webhook configuration.
META_VERIFY_TOKEN=

# Long-lived Page Access Token from Meta App → Messenger → Access Tokens
# Single page expected (FitHer's main FB Page). Multi-page support already
# in the meta_pages DB table — register additional pages via API.
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=

# Graph API version (locked; bump when Meta deprecates)
META_GRAPH_VERSION=v21.0

# ─── Phase 6 — FitHer App Backend Integration ────────────────
# Shared HMAC secret used to sign webhook payloads from the FitHer
# app backend (partner_backend). MUST match the app backend's
# CRM_WEBHOOK_SECRET. Generate a random 40+ char string.
APP_WEBHOOK_SECRET=
